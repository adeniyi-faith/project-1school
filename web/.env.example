# Base URL of the Laravel API this web app talks to.
# Never hard-code this in source files — always read it from here.
VITE_API_URL=http://localhost:8000/api

# From your Supabase project's Settings > API page.
# The anon key is safe to expose in the browser — it only allows what
# your Supabase project's access rules (RLS policies) permit.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
