APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Show one-click demo logins on the sign-in page. Keep false on a real site.
SHOW_DEMO_ACCOUNTS=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development can use sqlite (zero setup). For Supabase's Postgres
# database, switch to the values from your Supabase project's
# Settings > Database > Connection string.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" runs jobs immediately, no setup needed. If you turn on the
# optional "worker" process in the Procfile (Railway lets you run it as
# a second service), switch this to "database" so jobs queue properly
# instead of running inline.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# How people sign in: "local" checks the email and password against this
# app's own database (MySQL on cPanel, nothing else needed). Use "supabase"
# only if you want Supabase to check passwords, and then fill in the keys below.
LOGIN_DRIVER=local

# Only needed when LOGIN_DRIVER=supabase (or for Supabase file storage).
# From your Supabase project's Settings > API page. Used both to check
# logins (Supabase confirms the password; Laravel still decides what
# that person is allowed to do) and, further down, for file storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A redeploy on most hosts (including Railway) wipes the server's own
# disk, so uploads (school logos, documents, photos) should go to
# Supabase Storage instead. Create a bucket under Storage, then copy its
# S3-compatible keys from Storage > "Connect".
# Uploads use the app's own storage folder (FILESYSTEM_DISK=local, set above).
# To use Supabase Storage instead, set FILESYSTEM_DISK=supabase and fill in:
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=

# Let visitors click "Try the demo" on the sign-in page and look around a
# demo school without an account. The demo is read-only: nothing can be
# saved or changed. Set it to false to hide the demo.
DEMO_ENABLED=true
DEMO_EMAIL=demo@schoolruns.demo
